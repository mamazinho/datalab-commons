# Variáveis lidas pelo ObservabilitySettings. Cada serviço declara estas no próprio .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Logfire: recebe tudo, inclusive o conteúdo das conversas dos agentes.
LOGFIRE_TOKEN=

# Grafana Cloud: recebe logs de aplicação (Loki) e traces de operação (Tempo).
# Vazio desliga o envio sem afetar o resto.
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_HEADERS=

# Console do logfire com os spans; deixar false em produção.
CONSOLE_SPANS=true

# Prompts e respostas dos agentes na telemetria (só chegam ao Logfire).
CAPTURE_AI_CONTENT=true

# Amostragem de traces. Erros e requisições lentas passam mesmo abaixo de 1.0.
TRACE_SAMPLE_RATE=1.0

# Aceitar traceparent de entrada. true apenas em serviço interno: numa API pública
# qualquer cliente poderia injetar trace_id.
DISTRIBUTED_TRACING=false
